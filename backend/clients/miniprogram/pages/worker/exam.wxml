<!-- 洗车工端 · 在线考试（C3 精细认证，80 分及格） -->
<view class="page worker-exam">
  <view class="sim-banner">
    <text class="sim-icon">⚠</text>
    <text>测试环境 · 模拟支付 · 不产生真实资金收付</text>
  </view>

  <view class="container">
    <view class="card exam-head">
      <view class="card-title"><text>{{cert}} 精细认证考试</text><text class="tag tag-warning">及格线 80 分</text></view>
      <view class="muted">共 {{questions.length}} 题，每题 10 分。通过后解锁精细清洁订单抢单权限。</view>
    </view>

    <view class="card question" wx:for="{{questions}}" wx:key="id">
      <view class="q-title">{{index + 1}}. {{item.q}}</view>
      <view class="option {{item.selected === optIndex ? 'on' : ''}}"
            wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="optIndex" wx:key="*this"
            data-q="{{index}}" data-o="{{optIndex}}" bindtap="onPick">
        <view class="radio {{item.selected === optIndex ? 'checked' : ''}}"></view>
        <text>{{opt}}</text>
      </view>
    </view>

    <view class="card result" wx:if="{{submitted}}">
      <view class="result-score {{passed ? 'result-pass' : 'result-fail'}}">{{score}} 分</view>
      <view class="center mt-16">{{passed ? '考试通过，C3 精细认证已解锁，可承接高阶订单。' : '未达 80 分，请复习后重新考试。'}}</view>
    </view>

    <button class="btn btn-primary btn-block" bindtap="onSubmit" wx:if="{{!submitted}}">提交试卷</button>
    <button class="btn btn-ghost btn-block mt-16" bindtap="onReset">重新考试</button>
  </view>
</view>
