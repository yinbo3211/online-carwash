<!-- 洗车工端 · 收入钱包（金额为分） -->
<view class="page worker-income">
  <view class="sim-banner">
    <text class="sim-icon">⚠</text>
    <text>测试环境 · 模拟支付 · 不产生真实资金收付</text>
  </view>

  <view class="container">
    <view class="wallet">
      <view class="wallet-label">本月可提现（示例）</view>
      <view class="wallet-amount price">{{withdrawText}}</view>
      <view class="wallet-sub">累计收入 ¥{{totalText}} · 平台服务费抽成 35% · 洗车工分成 40%</view>
      <button class="btn btn-sim wallet-btn" bindtap="onWithdraw">模拟提现</button>
    </view>

    <view class="card">
      <view class="card-title"><text>收入明细</text><text class="muted">金额单位：分 → 元</text></view>
      <view class="bill" wx:for="{{bills}}" wx:key="id">
        <view class="row between">
          <view>
            <view class="bill-title">{{item.title}}</view>
            <view class="muted">{{item.date}} · {{item.no}}</view>
          </view>
          <view class="bill-right">
            <view class="price bill-amount">{{item.amountText}}</view>
            <view class="muted">服务费 {{item.feeText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title"><text>结算口径</text></view>
      <view class="row between"><text>用户支付</text><text class="muted">含 L1 强制保障（¥0）</text></view>
      <view class="divider"></view>
      <view class="row between"><text>平台服务费</text><text>35%</text></view>
      <view class="divider"></view>
      <view class="row between"><text>洗车工分成</text><text>40%</text></view>
      <view class="divider"></view>
      <view class="row between"><text>提现通道</text><text class="tag tag-warning">V1 模拟，不产生真实资金</text></view>
    </view>
  </view>
</view>
