<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiche.learning.dao.ExamRecordMapper">
    <resultMap id="ExamResultMap" type="com.xiche.learning.entity.Exam">
        <id column="id" property="id"/>
        <result column="exam_code" property="examCode"/>
        <result column="exam_name" property="examName"/>
        <result column="cert_code" property="certCode"/>
        <result column="pass_score" property="passScore"/>
        <result column="total_score" property="totalScore"/>
        <result column="status" property="status"/>
    </resultMap>

    <resultMap id="QuestionResultMap" type="com.xiche.learning.entity.Question">
        <id column="id" property="id"/>
        <result column="exam_id" property="examId"/>
        <result column="title" property="title"/>
        <result column="option_a" property="optionA"/>
        <result column="option_b" property="optionB"/>
        <result column="option_c" property="optionC"/>
        <result column="option_d" property="optionD"/>
        <result column="correct_option" property="correctOption"/>
        <result column="score" property="score"/>
    </resultMap>

    <resultMap id="RecordResultMap" type="com.xiche.learning.entity.ExamRecord">
        <id column="id" property="id"/>
        <result column="worker_id" property="workerId"/>
        <result column="exam_id" property="examId"/>
        <result column="cert_code" property="certCode"/>
        <result column="score" property="score"/>
        <result column="result" property="result"/>
        <result column="submitted_at" property="submittedAt"/>
    </resultMap>

    <select id="selectExamById" resultMap="ExamResultMap">
        SELECT id, exam_code, exam_name, cert_code, pass_score, total_score, status
        FROM t_exam WHERE id = #{examId} AND deleted_at IS NULL
    </select>

    <select id="selectQuestions" resultMap="QuestionResultMap">
        SELECT id, exam_id, title, option_a, option_b, option_c, option_d, correct_option, score
        FROM t_question WHERE exam_id = #{examId} AND deleted_at IS NULL ORDER BY id ASC
    </select>

    <select id="selectById" resultMap="RecordResultMap">
        SELECT id, worker_id, exam_id, cert_code, score, result, submitted_at
        FROM t_exam_record WHERE id = #{id} AND deleted_at IS NULL
    </select>

    <select id="selectByWorker" resultMap="RecordResultMap">
        SELECT id, worker_id, exam_id, cert_code, score, result, submitted_at
        FROM t_exam_record WHERE worker_id = #{workerId} AND deleted_at IS NULL ORDER BY id DESC
    </select>

    <insert id="insert" parameterType="com.xiche.learning.entity.ExamRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_exam_record (worker_id, exam_id, cert_code, score, result,
                                   submitted_at, created_at, updated_at)
        VALUES (#{workerId}, #{examId}, #{certCode}, #{score}, #{result},
                NOW(), NOW(), NOW())
    </insert>
</mapper>
